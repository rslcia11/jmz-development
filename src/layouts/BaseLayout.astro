---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "JMZ Development & Solutions",
  description = "Tecnología, software, automatización e inteligencia artificial.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0a" />
    <title>{title}</title>

    <!--
      Set inline, before first paint. .motion-ready gates reveal styles (no
      flash of visible content); .js swaps no-JS fallbacks such as the mobile
      nav CTA for the menu toggle. Without JS neither class exists, so every
      section stays readable and navigable.
    -->
    <script is:inline>
      document.documentElement.classList.add("js", "motion-ready");
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Navigation />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // The hero animates on load (hero-motion.css), so it's not observed.
      const sections = document.querySelectorAll("main > section:not(.hero)");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        // A ratio threshold is relative to the section's own height, so a tall
        // section (Work on mobile) may never reach it and stay hidden. Trigger
        // on first contact instead; rootMargin sets how far into view that is.
        {
          threshold: 0,
          rootMargin: "0px 0px -8% 0px",
        },
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  </body>
</html>

