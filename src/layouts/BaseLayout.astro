---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SystemStage from "../components/SystemStage.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  // Search intent first: the title leads with the query people type (§53).
  title = "Desarrollo de software a medida en Ecuador | JMZ Development",
  description = "Sistemas de gestión y ERP, inteligencia artificial y páginas web a medida. Te escuchamos primero y construimos lo que te ayuda a crecer.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0a" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- The headline is the LCP: fetch its font with the HTML, not after the CSS. -->
    <link
      rel="preload"
      href="/fonts/geist/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!--
      Set inline, before first paint. .motion-ready gates reveal styles (no
      flash of visible content); .js swaps no-JS fallbacks such as the mobile
      nav CTA for the menu toggle. Without JS neither class exists, so every
      section stays readable and navigable.
    -->
    <script is:inline>
      document.documentElement.classList.add("js", "motion-ready");
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <SystemStage />
    <Navigation />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Scroll reveal for [data-reveal] (styles in motion.css).
      const observer = new IntersectionObserver(
        (entries) => {
          const entering = entries.filter((entry) => entry.isIntersecting);

          // Stagger within this batch only: whatever enters together cascades.
          entering.forEach((entry, index) => {
            const element = entry.target as HTMLElement;
            element.style.setProperty("--reveal-index", String(index));
            element.classList.add("is-visible");
            observer.unobserve(element);
          });
        },
        // Ratio thresholds are relative to the element's own height, so a tall
        // element might never reach one. Trigger on first contact instead;
        // rootMargin sets how far into view that is.
        {
          threshold: 0,
          rootMargin: "0px 0px -8% 0px",
        },
      );

      document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element));
    </script>

    <script>
      import "../scripts/text-motion";
    </script>
  </body>
</html>

