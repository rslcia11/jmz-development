---
import HeroSystem from "./HeroSystem.astro";
import { contactLink } from "../data/navigation";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <p class="hero__eyebrow">Desarrollo de software a medida</p>

      <h1 id="hero-title" class="hero__title">
        Construimos sistemas ERP, modelos de IA y sitios web.
        <span class="hero__title-aside">Pero antes, preguntamos para qué.</span>
      </h1>

      <p class="hero__description">
        Primero entendemos cómo funciona tu negocio y qué necesitas lograr.
        Después construimos la solución, y no la damos por terminada hasta que
        cumple ese objetivo.
      </p>

      <div class="hero__actions">
        <a class="hero__primary-action" href={contactLink.href}>Cuéntanos tu caso</a>
        <a class="hero__secondary-action" href="/#work">Ver lo que construimos</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <HeroSystem />
    </div>
  </div>
</section>
