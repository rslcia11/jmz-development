---
import HeroSystem from "./HeroSystem.astro";
import { contactLink } from "../data/navigation";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <p class="hero__eyebrow">Desarrollo de software a medida · Ecuador</p>

      <h1 id="hero-title" class="hero__title">
        Convertimos tu idea en software.
      </h1>

      <!-- The headline stays an umbrella; the concrete "what" lives here (docs/copy.md). -->
      <p class="hero__description">
        Y también ese problema que te quita tiempo. Sistemas de gestión y ERP,
        soluciones con inteligencia artificial y páginas web. Te escuchamos
        primero y te acompañamos hasta que funcione.
      </p>

      <div class="hero__actions">
        <a class="hero__primary-action" href={contactLink.href}>Hagámoslo software</a>
        <a class="hero__secondary-action" href="/#work">Ver proyectos reales</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <HeroSystem />
    </div>
  </div>
</section>
