---
import HeroSystem from "./HeroSystem.astro";
import { contactLink } from "../data/navigation";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <p class="hero__eyebrow">JMZ Development & Solutions</p>

      <h1 id="hero-title" class="hero__title">
        Tecnología que entiende.
        <br />
        Ingeniería que cumple.
      </h1>

      <p class="hero__description">
        Diseñamos y construimos software, automatización e inteligencia artificial
        para convertir objetivos complejos en soluciones reales.
      </p>

      <div class="hero__actions">
        <a class="hero__primary-action" href={contactLink.href}>{contactLink.label}</a>
        <a class="hero__secondary-action" href="/#work">Ver proyectos</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <HeroSystem />
    </div>
  </div>
</section>
