---
import { projects } from "../data/projects";

const [featured, ...rest] = projects;
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="work__header container" data-reveal>
    <p class="work__eyebrow">03 — Work</p>

    <div class="work__heading">
      <h2 id="work-title" class="work__title">Lo que construimos.</h2>

      <p class="work__lead">
        Algunos proyectos recientes. Por confidencialidad no mostramos nombres de
        clientes: mostramos el problema y cómo lo resolvimos.
      </p>
    </div>
  </div>

  <div class="work__projects container">
    {featured && (
      <article class="work-project work-project--featured" data-reveal>
        <div class="work-project__visual" aria-hidden="true">
          <div class="work-project__placeholder">
            <span>{featured.type}</span>
          </div>
        </div>

        <div class="work-project__content">
          <div class="work-project__meta">
            <span>{number(0)}</span>
            <span>{featured.type}</span>
          </div>

          <h3 class="work-project__title">{featured.title}</h3>

          <dl class="work-project__details">
            <div class="work-project__detail">
              <dt class="work-project__label">Problema</dt>
              <dd>{featured.problem}</dd>
            </div>

            <div class="work-project__detail">
              <dt class="work-project__label">Solución</dt>
              <dd>{featured.solution}</dd>
            </div>

            <div class="work-project__detail">
              <dt class="work-project__label">Resultado</dt>
              <dd>{featured.result}</dd>
            </div>
          </dl>
        </div>
      </article>
    )}

    <div class="work-projects__grid">
      {rest.map((project, index) => (
        <article class="work-project work-project--secondary" data-reveal>
          <div class="work-project__visual" aria-hidden="true">
            <div class="work-project__placeholder">
              <span>{project.type}</span>
            </div>
          </div>

          <div class="work-project__content">
            <div class="work-project__meta">
              <span>{number(index + 1)}</span>
              <span>{project.type}</span>
            </div>

            <h3 class="work-project__title">{project.title}</h3>

            <p class="work-project__description">
              {project.problem} {project.solution}
            </p>

            <ul class="work-project__tags" role="list" aria-label="Áreas del proyecto">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
