---
import { workFormations } from "../data/formations";
import { erpWork, projects, webClients } from "../data/projects";
import SystemSlot from "./SystemSlot.astro";

const number = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="work__header container" data-reveal>
    <p class="work__eyebrow" data-decode>03 — Work</p>

    <div class="work__heading">
      <h2 id="work-title" class="work__title" data-split>Lo que construimos.</h2>

      <p class="work__lead">
        Proyectos reales, cada uno con lo que hace y con qué está hecho. Los ERP
        son confidenciales por pedido del cliente; del resto mostramos el
        detalle.
      </p>
    </div>
  </div>

  <div class="work__projects container">
    <article class="work-featured" data-reveal>
      <div class="work-featured__intro">
        <p class="work-project__meta"><span>{number(0)}</span><span>ERP</span></p>

        <h3 class="work-featured__title">Sistemas ERP a medida</h3>

        <p class="work-featured__summary">
          Hemos construido sistemas ERP completos, además de otros sistemas
          de gestión. Por confidencialidad con nuestros clientes no publicamos
          capturas ni detalles internos.
        </p>
      </div>

      <div class="work-featured__aside">
        <SystemSlot state="work:erp" formation={workFormations.erp} class="work-featured__visual" />

        <dl class="work-featured__list">
          {erpWork.map(({ name, description }) => (
            <div class="work-featured__item">
              <dt>{name}</dt>
              <dd>{description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </article>

    <div class="work-projects__grid">
      {projects.map((project, index) => (
        <article class="work-project" data-line data-reveal>
          <SystemSlot
            state={`work:${project.shape}`}
            formation={workFormations[project.shape]}
            class="work-project__visual"
          />

          <p class="work-project__meta">
            <span>{number(index + 1)}</span>
            <span>{project.type}</span>
          </p>

          <h3 class="work-project__title">{project.title}</h3>
          <p class="work-project__context">{project.context}</p>
          <p class="work-project__description">{project.summary}</p>

          <ul class="work-project__tags" role="list" aria-label="Tecnologías">
            {project.stack.map((tech) => <li>{tech}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="work-web" data-reveal>
      <p class="work-web__label" id="work-web-label">Sitios web para</p>

      <ul class="work-web__clients" role="list" aria-labelledby="work-web-label">
        {webClients.map(({ name, business }) => (
          <li>
            <strong>{name}</strong>
            <span>{business}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
