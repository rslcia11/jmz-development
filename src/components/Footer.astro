---
import { allLinks, contactEmail, whatsapp } from "../data/navigation";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="JMZ Development & Solutions — Inicio">
        <Logo />
      </a>

      <p>
        Convertimos tu idea en software.
      </p>
    </div>

    <div class="site-footer__contact">
      <p class="site-footer__label">Contacto</p>

      <a href={whatsapp.href} target="_blank" rel="noopener noreferrer">
        WhatsApp {whatsapp.display}
      </a>

      <a href={`mailto:${contactEmail}`}>
        {contactEmail}
      </a>
    </div>

    <nav class="site-footer__links" aria-label="Navegación del pie de página">
      <p class="site-footer__label">Explore</p>

      {allLinks.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>

    <div class="site-footer__social">
      <p class="site-footer__label">Connect</p>

      <a href="https://github.com/rslcia11" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>© 2026 JMZ Development & Solutions LLC. Todos los derechos reservados.</p>
    <p>Guayaquil, Ecuador</p>
  </div>
</footer>
