---
/*
  JMZ signature graphic as a static SVG: the finished system, no script.
  It is what people see without WebGL, with reduced motion or Save-Data, and
  while the 3D scene loads; when the scene takes over it hides this
  (ADR 0002). Layout lives in src/data/system.ts, shared with the 3D scene.
  [data-system-slot] makes this box the place the 3D scene maps itself onto.
*/
import {
  SYSTEM_SIZE,
  systemGuides,
  systemLines,
  systemLinks,
  systemModules,
} from "../data/system";
---

<svg
  class="hero-system"
  data-system-slot="hero"
  viewBox={`0 0 ${SYSTEM_SIZE} ${SYSTEM_SIZE}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {systemGuides.map((at) => (
    <>
      <line class="hero-system__guide" x1={at} y1="0" x2={at} y2={SYSTEM_SIZE} />
      <line class="hero-system__guide" x1="0" y1={at} x2={SYSTEM_SIZE} y2={at} />
    </>
  ))}

  {systemLines.map(([x1, y1, x2, y2]) => (
    <line class="hero-system__link" x1={x1} y1={y1} x2={x2} y2={y2} />
  ))}

  {systemLinks.map(([x1, y1, x2, y2]) => (
    <circle class="hero-system__node" cx={(x1 + x2) / 2} cy={(y1 + y2) / 2} r="3" />
  ))}

  {systemModules.map(({ label, x, y, w, h, core }) => (
    <g class:list={["hero-system__module", { "hero-system__module--core": core }]}>
      <rect x={x} y={y} width={w} height={h} rx="2" />
      <text x={x + 12} y={y + 20}>{label}</text>
      {core && <rect class="hero-system__accent" x={x + w - 24} y={y + h - 24} width="12" height="12" />}
    </g>
  ))}
</svg>
